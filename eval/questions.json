{
  "description": "RAG 评测集。当前样例资料为《院系教学信息管理系统》毕业论文。换资料后请同步替换问题。",
  "schema": {
    "id": "唯一编号",
    "question": "用户问题",
    "type": "fact=单点事实型 / cross=跨章节综合型 / irrelevant=无关型（应拒答）",
    "expected_sections": "期望命中的章节/内容关键词，任一出现即算命中（在 section_title 或正文中子串匹配）",
    "expected_keywords": "期望出现在最终回答中的关键词（生成端评测用）",
    "allow_no_answer": "是否允许无答案（irrelevant 型为 true）"
  },
  "questions": [
    {
      "id": "fact_01",
      "question": "本系统采用了什么 Web 开发框架？",
      "type": "fact",
      "expected_sections": ["Django", "Python"],
      "expected_keywords": ["Django"],
      "allow_no_answer": false
    },
    {
      "id": "fact_02",
      "question": "系统使用了哪种数据库？",
